<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DimoTalk.Maui"
             x:Class="DimoTalk.Maui.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== 滴墨讲 主题色板 ===== -->
            <Color x:Key="PageBackground">#F4F4F9</Color>
            <Color x:Key="Primary">#5B5BD6</Color>
            <Color x:Key="PrimaryDark">#4242B8</Color>
            <Color x:Key="PrimaryLight">#EAEBF9</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1D1D2B</Color>
            <Color x:Key="TextSecondary">#8A8A99</Color>
            <Color x:Key="BubbleAI">#FFFFFF</Color>
            <Color x:Key="AccentOrange">#F59E0B</Color>
            <Color x:Key="AccentRed">#EF4444</Color>
            <Color x:Key="Divider">#E5E5EF</Color>
            <Color x:Key="OnlineGreen">#22C55E</Color>

            <!-- ===== 通用样式 ===== -->
            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>

            <Style x:Key="FieldHint" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="6,0,0,4"/>
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Divider}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="22,10"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="22,10"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
