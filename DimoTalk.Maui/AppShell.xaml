<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:DimoTalk.Maui.Pages"
       x:Class="DimoTalk.Maui.AppShell"
       Title="滴墨讲">

    <TabBar>
        <Tab Title="对话" Icon="chat.png">
            <ShellContent ContentTemplate="{DataTemplate pages:ChatPage}" />
        </Tab>
        <Tab Title="记忆馆" Icon="chat.png">
            <ShellContent ContentTemplate="{DataTemplate pages:MemoryPage}" />
        </Tab>
        <Tab Title="设置" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" />
        </Tab>
    </TabBar>
</Shell>
