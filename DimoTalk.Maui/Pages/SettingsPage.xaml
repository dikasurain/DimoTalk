<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DimoTalk.Maui.Pages.SettingsPage"
             Title="设置"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView Padding="16,12,16,24">
        <VerticalStackLayout Spacing="8">

            <!-- ===== 卷轴标题 ===== -->
            <StackLayout HorizontalOptions="Fill" Margin="0,4,0,10">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <BoxView WidthRequest="30" HeightRequest="1" BackgroundColor="{StaticResource InkFaint}"
                             VerticalOptions="Center"/>
                    <Label Text="文 房 四 宝" FontSize="12" TextColor="{StaticResource InkLight}"
                           VerticalOptions="Center"/>
                    <BoxView WidthRequest="30" HeightRequest="1" BackgroundColor="{StaticResource InkFaint}"
                             VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </StackLayout>

            <!-- ===== 服务商 ===== -->
            <Label Text="服务商" Style="{StaticResource SectionHeader}" Margin="4,8,0,2"/>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Picker x:Name="ProviderPicker" Title="选择服务商"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnProviderChanged"
                            TextColor="{StaticResource TextPrimary}"/>
                    <Label x:Name="ProviderDescription" FontSize="12" TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="WordWrap"/>
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="申请 API Key" FontSize="12" TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center"/>
                        <Label x:Name="WebsiteLink" FontSize="12" TextColor="{StaticResource Primary}"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWebsiteTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== 密钥 ===== -->
            <Label Text="API Key" Style="{StaticResource SectionHeader}" Margin="4,12,0,2"/>
            <Border Style="{StaticResource CardBorder}">
                <Entry x:Name="ApiKeyEntry" Placeholder="sk-…" IsPassword="True"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       TextColor="{StaticResource TextPrimary}"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <!-- 自定义 Endpoint（仅 custom 显示） -->
            <Label x:Name="EndpointLabel" Text="自定义 Endpoint" Style="{StaticResource SectionHeader}"
                   Margin="4,12,0,2" IsVisible="False"/>
            <Border x:Name="EndpointBorder" Style="{StaticResource CardBorder}" IsVisible="False">
                <Entry x:Name="EndpointEntry" Placeholder="https://…"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       TextColor="{StaticResource TextPrimary}"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <!-- ===== 模型配置 ===== -->
            <Label Text="模型配置" Style="{StaticResource SectionHeader}" Margin="4,12,0,2"/>
            <VerticalStackLayout Spacing="8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="对话模型（输入名称自动匹配服务商）" Style="{StaticResource FieldHint}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <Entry x:Name="ChatModelEntry" Placeholder="gpt-4o-mini / deepseek-chat / glm-4-flash…"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               TextColor="{StaticResource TextPrimary}"
                               TextChanged="OnChatModelChanged" ClearButtonVisibility="WhileEditing"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Embedding 模型" Style="{StaticResource FieldHint}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <Entry x:Name="EmbeddingModelEntry" Placeholder="text-embedding-3-small"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               TextColor="{StaticResource TextPrimary}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Whisper 语音识别模型（仅 OpenAI）" Style="{StaticResource FieldHint}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <Entry x:Name="WhisperModelEntry" Placeholder="whisper-1"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               TextColor="{StaticResource TextPrimary}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="TTS 语音合成模型（仅 OpenAI）" Style="{StaticResource FieldHint}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <Entry x:Name="TtsModelEntry" Placeholder="tts-1"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               TextColor="{StaticResource TextPrimary}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="TTS 音色" Style="{StaticResource FieldHint}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <Picker x:Name="TtsVoicePicker" Title="选择声音"
                                TextColor="{StaticResource TextPrimary}">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>alloy</x:String>
                                    <x:String>echo</x:String>
                                    <x:String>fable</x:String>
                                    <x:String>onyx</x:String>
                                    <x:String>nova</x:String>
                                    <x:String>shimmer</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===== 操作 ===== -->
            <HorizontalStackLayout Spacing="10" Margin="0,16,0,0">
                <Button Text="保存配置" Clicked="OnSaveClicked" Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="Fill" FontSize="15"/>
                <Button Text="重置" Clicked="OnResetClicked" Style="{StaticResource GhostButton}"/>
            </HorizontalStackLayout>

            <!-- ===== 记忆系统说明 ===== -->
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Divider}" Margin="0,20,0,8"/>
            <Label Text="关于记忆系统" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource CardBorder}" Margin="0,4,0,0">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Primary}"
                                VerticalOptions="Center"/>
                        <Label Text="短期记忆" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center"/>
                        <Label Text="当前对话最近 20 条上下文" FontSize="12"
                               TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center"
                               HorizontalOptions="EndAndExpand" LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource AccentOrange}"
                                VerticalOptions="Center"/>
                        <Label Text="中期记忆" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center"/>
                        <Label Text="会话结束自动生成摘要存入 SQLite" FontSize="12"
                               TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center"
                               HorizontalOptions="EndAndExpand" LineBreakMode="TailTruncation"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource OnlineGreen}"
                                VerticalOptions="Center"/>
                        <Label Text="长期记忆" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center"/>
                        <Label Text="用户偏好与事实 · 向量检索" FontSize="12"
                               TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center"
                               HorizontalOptions="EndAndExpand" LineBreakMode="TailTruncation"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
