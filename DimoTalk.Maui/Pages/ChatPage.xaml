<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DimoTalk.Maui.Behaviors"
             x:Class="DimoTalk.Maui.Pages.ChatPage"
             Title="滴墨讲"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== 顶栏：印章 + 品名 + 模式切换 ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Padding="18,12,18,10">
            <!-- 朱砂印章头像 -->
            <Border x:Name="SealBadge" Grid.Column="0" WidthRequest="42" HeightRequest="42"
                    StrokeThickness="0" StrokeShape="RoundRectangle 6"
                    BackgroundColor="{StaticResource Cinnabar}"
                    Padding="2">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 4"
                        Stroke="{StaticResource Cinnabar}"
                        BackgroundColor="Transparent"
                        IsVisible="False"/>
                <Label Text="墨" TextColor="#F5F2EA" FontSize="20" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
            </Border>
            <!-- 品名 + 状态 -->
            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                <Label Text="滴墨讲" FontSize="17" FontAttributes="Bold"
                       TextColor="{StaticResource InkHeavy}"/>
                <HorizontalStackLayout Spacing="5">
                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{StaticResource OnlineGreen}"/>
                    <Label x:Name="StatusLabel" Text="墨已研好 · 静候落笔" FontSize="11"
                           TextColor="{StaticResource TextSecondary}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <!-- 对话模式切换：闲聊（记忆+方言） / 快答（单轮直答） -->
            <Button x:Name="ModeButton" Grid.Column="3" Text="闲聊" Clicked="OnModeClicked"
                    CornerRadius="4" Padding="12,4" FontSize="12"
                    BackgroundColor="{StaticResource InkWash}"
                    TextColor="{StaticResource InkMedium}"
                    VerticalOptions="Center"/>
            <!-- 右侧竖排装饰字 -->
            <Label Grid.Column="4" Text="笔墨纸砚" FontSize="10" TextColor="{StaticResource InkFaint}"
                   Rotation="90" VerticalOptions="Center" Margin="0,0,2,0"/>
            <!-- 底部墨线 -->
            <BoxView Grid.ColumnSpan="5" Grid.Column="0" HeightRequest="1"
                     BackgroundColor="{StaticResource Divider}" VerticalOptions="End"/>
        </Grid>

        <!-- ===== 消息区 ===== -->
        <CollectionView x:Name="MessagesView" Grid.Row="1" Margin="10,4,10,4"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        VerticalScrollBarVisibility="Default">
            <CollectionView.EmptyView>
                <StackLayout Padding="32" VerticalOptions="Center" HorizontalOptions="Center">
                    <!-- 印章式大图标：钤盖进场 + 墨晕呼吸 -->
                    <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                            StrokeThickness="2" StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource Cinnabar}" BackgroundColor="Transparent"
                            Margin="0,0,0,0">
                        <Border.Behaviors>
                            <behaviors:SealInkBloomBehavior/>
                        </Border.Behaviors>
                        <Label Text="墨" TextColor="{StaticResource Cinnabar}" FontSize="34"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Border>
                    <Label Text="落笔即成对话" FontSize="19" FontAttributes="Bold"
                           TextColor="{StaticResource InkHeavy}" HorizontalTextAlignment="Center"
                           Margin="0,18,0,4"/>
                    <Label Text="说出「滴墨」唤醒语音&#x0a;记忆如墨 · 入纸三分"
                           FontSize="13" TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Border 替代 Frame：单层布局，动态高度测量可靠，长文本不截断 -->
                    <Border Padding="14,10" StrokeThickness="0"
                            BackgroundColor="{Binding BubbleColor}"
                            HorizontalOptions="{Binding Alignment}"
                            StrokeShape="RoundRectangle 4,4,4,12"
                            Margin="6,3,60,3">
                        <Border.Behaviors>
                            <behaviors:BubbleEnterBehavior/>
                        </Border.Behaviors>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                <Setter Property="StrokeShape" Value="RoundRectangle 4,12,4,4"/>
                                <Setter Property="Margin" Value="60,3,6,3"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsThinking}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource InkWash}"/>
                                <Setter Property="Margin" Value="6,3,120,3"/>
                            </DataTrigger>
                            <!-- AI 长回复：右侧留白 60→20，多容纳两列文字 -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsLongContent}" Value="True">
                                <Setter Property="Margin" Value="6,3,20,3"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="3">
                            <!-- 思考态：三个墨点循环（IsThinking 时显示） -->
                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,2" IsVisible="False">
                                <HorizontalStackLayout.Behaviors>
                                    <behaviors:GrindingDotsBehavior/>
                                </HorizontalStackLayout.Behaviors>
                                <HorizontalStackLayout.Triggers>
                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsThinking}" Value="True">
                                        <Setter Property="IsVisible" Value="True"/>
                                    </DataTrigger>
                                </HorizontalStackLayout.Triggers>
                                <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3" BackgroundColor="{StaticResource InkLight}"
                                        Opacity="0.15"/>
                                <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3" BackgroundColor="{StaticResource InkLight}"
                                        Opacity="0.15"/>
                                <Border WidthRequest="7" HeightRequest="7" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3" BackgroundColor="{StaticResource InkLight}"
                                        Opacity="0.15"/>
                                <Label Text="研墨构思中" FontSize="13" FontAttributes="Italic"
                                       TextColor="{StaticResource TextSecondary}" Margin="4,0,0,0"
                                       VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Content}" TextColor="{Binding TextColor}"
                                   FontSize="15" LineBreakMode="WordWrap"
                                   IsVisible="{Binding ShowContent}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsThinking}" Value="True">
                                        <Setter Property="FontAttributes" Value="Italic"/>
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Time}" FontSize="10"
                                   TextColor="{Binding TimeColor}" HorizontalOptions="End"
                                   IsVisible="{Binding ShowContent}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ===== 笔架输入栏 ===== -->
        <Border Grid.Row="2" Margin="12,8,12,50" Padding="6,5"
                Stroke="{StaticResource Divider}" StrokeThickness="1"
                StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Surface}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Button x:Name="VoiceButton" Grid.Column="0" Text="语音" Clicked="OnVoiceClicked"
                        Style="{StaticResource GhostButton}" CornerRadius="4" Padding="16,8"
                        BackgroundColor="{StaticResource InkWash}"
                        TextColor="{StaticResource InkMedium}"/>
                <Entry x:Name="InputEntry" Grid.Column="1" Placeholder="落笔…"
                       PlaceholderColor="{StaticResource InkFaint}"
                       TextColor="{StaticResource TextPrimary}" FontSize="15"
                       Focused="OnEntryFocused" Unfocused="OnEntryUnfocused"
                       ReturnType="Send" Completed="OnSendClicked"
                       ClearButtonVisibility="WhileEditing" BackgroundColor="Transparent"/>
                <Button x:Name="SendButton" Grid.Column="2" Text="落墨" Clicked="OnSendClicked"
                        Style="{StaticResource PrimaryButton}" CornerRadius="4" Padding="18,8"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
